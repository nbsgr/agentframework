{
  "name": "coderun-agent",
  "version": "1.0.8",
  "description": "Standalone, multi-provider AI Agent framework in plain JavaScript",
  "main": "index.js",
  "type": "module",
  "author": "nbsgr",
  "repository": {
    "type": "git",
    "url": "https://github.com/nbsgr/agentframework.git"
  },
  "bugs": {
    "url": "https://github.com/nbsgr/agentframework/issues"
  },
  "homepage": "https://nbsgr.github.io/agentframework/",
  "keywords": [
    "agent",
    "agents",
    "ai",
    "llm",
    "ollama",
    "anthropic",
    "claude",
    "gemini",
    "openai",
    "mcp",
    "subagents",
    "guardrails",
    "tool-calling"
  ],
  "exports": {
    ".": "./index.js",
    "./traces": "./src/executionTrace.js",
    "./subagents": "./src/subagentManager.js",
    "./planning": "./src/planningManager.js",
    "./planningEngine": "./src/planningEngine.js",
    "./compaction": "./src/compactionManager.js",
    "./checkpoints": "./src/checkpointManager.js",
    "./diffs": "./src/diffManager.js",
    "./tools": "./src/tools.js",
    "./state": "./src/agentState.js",
    "./guardrails": "./src/guardrails.js",
    "./recovery": "./src/recoveryEngine.js",
    "./pathSecurity": "./src/pathSecurity.js",
    "./fileLock": "./src/fileLock.js",
    "./providers": "./src/providers/providerManager.js"
  },
  "files": [
    "index.js",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/runDeterministicTests.js && node test/test_sdk_exports.js",
    "test:exports": "node test/test_sdk_exports.js",
    "test:smoke": "node test/runTests.js",
    "test:live": "node test/test_live_supported_providers.js",
    "test:mcp": "node test/test_mcp_filesystem.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.0",
    "openai": "^4.85.4"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@modelcontextprotocol/client": ">=1.0.0",
    "@modelcontextprotocol/sdk": ">=1.0.0",
    "coderun-tools": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "coderun-tools": {
      "optional": true
    },
    "@modelcontextprotocol/client": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  }
}
